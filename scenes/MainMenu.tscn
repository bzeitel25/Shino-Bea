; Three labels, not one — the title is two-tone per sibling and a single Label
; can only carry one colour. UISkin.skin_main_menu() paints them:
;   SHINO = deep-blue Gi + orange shadow · & = sumi ink · BEA = pink Gi + teal
; Press Start 2P @40: 200 + 120 + 120 = 440 px inside a 528 px interior.
[node name="TitleRow" type="HBoxContainer" parent="ScrollFrame/ScrollBody/Content"]
layout_mode = 2
theme_override_constants/separation = 0
alignment = 1

[node name="TitleShino" type="Label" parent="ScrollFrame/ScrollBody/Content/TitleRow"]
layout_mode = 2
text = "SHINO"

[node name="TitleAmp" type="Label" parent="ScrollFrame/ScrollBody/Content/TitleRow"]
layout_mode = 2
text = " & "

[node name="TitleBea" type="Label" parent="ScrollFrame/ScrollBody/Content/TitleRow"]
layout_mode = 2
text = "BEA"

[node name="SubtitleLabel" type="Label" parent="ScrollFrame/ScrollBody/Content"]
layout_mode = 2
text = "双影ノ忍  ·  the sibling shadows"
horizontal_alignment = 1

; KEEP_CENTERED, never SCALE. divider.png is a 512x18 tapered brush stroke;
; stretching it to the panel width turned the taper into two lumps.
