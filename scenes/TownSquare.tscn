[gd_scene load_steps=6 format=3 uid="uid://town_square"]

[ext_resource type="Script" path="res://scripts/TownSquare.gd" id="1_town"]
[ext_resource type="PackedScene" uid="uid://shino_player" path="res://scenes/Shino.tscn" id="2_player"]
[ext_resource type="PackedScene" uid="uid://shino_bea" path="res://scenes/Bea.tscn" id="3_bea"]
[ext_resource type="PackedScene" path="res://scenes/HUD.tscn" id="4_hud"]
[ext_resource type="Script" path="res://scripts/CameraFollow.gd" id="5_cam"]

[node name="TownSquare" type="Node2D"]
