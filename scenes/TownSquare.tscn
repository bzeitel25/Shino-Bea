; ── Plaza, dojo landmark, gates and carnival arch are generated
;    procedurally in TownSquare.gd via DayTerrain.gd. ──

[node name="HUD" parent="." instance=ExtResource("4_hud")]

[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector2(-26, 60)

[node name="Bea" parent="." instance=ExtResource("3_bea")]
