; ============================================================
; BOSS HP bar — top-of-screen, full-width (Run 15).
; Hidden by default; HUD.gd toggles visibility on FX bus signals
; (boss_registered / boss_unregistered) and refreshes fill via
; boss_hp_changed.
;
; Layout (top-stretch, 32px tall, 24px gap from top):
;   [NameLabel — left]        [PctLabel + ValueLabel — right]
;   [============== bar bg with fill ===============]
;        [tick @ 60%]                 [tick @ 30%]
; ============================================================
[node name="BossBarSection" type="Control" parent="."]
visible = false
anchor_left = 0.0
anchor_top = 0.0
anchor_right = 1.0
anchor_bottom = 0.0
offset_left = 40.0
offset_top = 16.0
offset_right = -40.0
offset_bottom = 60.0

