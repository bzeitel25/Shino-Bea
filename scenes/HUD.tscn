[gd_scene load_steps=2 format=3 uid="uid://shino_hud"]

[ext_resource type="Script" path="res://scripts/HUD.gd" id="1_hud"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")
layer = 10

; ============================================================
; Run 164 geometry note — READ BEFORE MOVING ANYTHING
; ============================================================
; UISkin.frame_meter() hangs a NinePatchRect BEHIND each *BarBG,
; grown outward by the frame margins: 12 px left/right/top and
; 10 px bottom. So a bar's real on-screen footprint is
;
;     x:  BarBG.left - 12  ..  BarBG.right + 12
;     y:  BarBG.top  - 12  ..  BarBG.bottom + 10
;
; The HP and Chi rows are therefore 44 px apart (not the old 26),
; which leaves a clean 6 px gap between the two frames. The value
; labels start 20 px clear of the frame's right edge, and the
; caption labels end 4 px clear of its left edge.
;
; BarBG must stay exactly 200 px wide — HUD.gd's BAR_MAX_WIDTH.
; ============================================================

; ── SHINO — bottom-left ─────────────────────────────────────
[node name="HPSection" type="Control" parent="."]
anchor_left = 0.0
anchor_top = 1.0
anchor_right = 0.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -110.0
offset_right = 400.0
offset_bottom = -84.0
mouse_filter = 2

[node name="HPLabel" type="Label" parent="HPSection"]
offset_left = 0.0
offset_top = 3.0
offset_right = 40.0
offset_bottom = 21.0
text = "HP"

[node name="HPBarBG" type="ColorRect" parent="HPSection"]
offset_left = 52.0
offset_top = 2.0
offset_right = 252.0
offset_bottom = 18.0
color = Color(0.22, 0.04, 0.04, 1)

[node name="HPBarFill" type="ColorRect" parent="HPSection/HPBarBG"]
offset_left = 0.0
offset_top = 0.0
offset_right = 200.0
offset_bottom = 16.0
color = Color(0.75, 0.16, 0.15, 1)

[node name="HPValueLabel" type="Label" parent="HPSection"]
